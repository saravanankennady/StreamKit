{
  "name": "elnova-streamkit-meeting",
  "version": "0.1.0",
  "private": true,
  "description": "Elnova StreamKit's meeting app, served at /meet.",
  "scripts": {
    "dev": "next dev -p 3300",
    "prebuild": "for d in sdk-js sdk-react; do [ -d ../$d/node_modules ] || npm --prefix ../$d ci; npm --prefix ../$d run build; done",
    "build": "next build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@elnova-streamkit/client": "file:../sdk-js",
    "@elnova-streamkit/react": "file:../sdk-react",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
