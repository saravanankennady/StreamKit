{
  "name": "@elnova-streamkit/client",
  "version": "0.1.0",
  "description": "Browser client SDK for Elnova StreamKit: rooms, participants, tracks and data over WebRTC.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "proto": "cd ../proto && buf generate --template buf.gen.ts.yaml",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
