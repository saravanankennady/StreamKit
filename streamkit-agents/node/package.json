{
  "name": "@elnova-streamkit/agents",
  "version": "0.1.0",
  "description": "Voice AI agents for Elnova StreamKit, for Node.js. The same API shape as the Python framework, and not yet as complete.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "proto": "cd ../.. && cd proto && buf generate --template ../streamkit-agents/node/buf.gen.yaml",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@evan/opus": "^1.0.3",
    "werift": "^0.22.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
