{
  "name": "@elnova-streamkit/server-sdk",
  "version": "0.1.0",
  "description": "Node.js server SDK for Elnova StreamKit: access tokens, webhook checks, and clients for rooms, recording and ingest.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "NOTICE.md", "LICENSE.protocol"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "proto": "cd ../../proto && buf generate --template ../sdks/server-node/buf.gen.yaml",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@types/node": "^22.0.0",
    "livekit-server-sdk": "2.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
