# Where the Elnova StreamKit server's REST API lives. Next.js proxies /api/v1/* to it. Read at build time.
STREAMKIT_API_URL=http://localhost:7880

# Origin of the live metrics WebSocket, which cannot go through the proxy. Read at build time.
# Leave it empty when the dashboard and the server sit behind one host: the page's own origin is used.
NEXT_PUBLIC_STREAMKIT_WS_ORIGIN=ws://localhost:7880
