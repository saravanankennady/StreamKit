# Copy to .env and fill in. Keep this file out of version control, and back up STREAMKIT_MASTER_KEY: losing it makes
# every stored API secret unreadable.

# The public DNS name of this host, and its public IP address.
STREAMKIT_DOMAIN=rtc.example.com
STREAMKIT_PUBLIC_IP=203.0.113.10
STREAMKIT_REGION=default

# Directory with fullchain.pem and privkey.pem for STREAMKIT_DOMAIN.
STREAMKIT_TLS_DIR=/etc/letsencrypt/live/rtc.example.com

# Generate each of these with: openssl rand -hex 32
STREAMKIT_MASTER_KEY=
STREAMKIT_DB_PASSWORD=
STREAMKIT_WORKER_DB_PASSWORD=
STREAMKIT_REDIS_PASSWORD=
STREAMKIT_TURN_SECRET=
STREAMKIT_METRICS_TOKEN=
STREAMKIT_GRAFANA_PASSWORD=

# Whether people can make accounts once the first one exists. The first can always be made, and becomes the administrator.
STREAMKIT_ALLOW_REGISTRATION=false

# Outgoing mail, for email verification and password reset.
STREAMKIT_MAIL_FROM=noreply@example.com
STREAMKIT_SMTP_HOST=
STREAMKIT_SMTP_PORT=587
STREAMKIT_SMTP_USERNAME=
STREAMKIT_SMTP_PASSWORD=
