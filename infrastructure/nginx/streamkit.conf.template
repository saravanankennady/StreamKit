# Terminates TLS for the dashboard, meeting app, API and signalling. Media does not pass through here.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream streamkit_server    { server server:7880; }
upstream streamkit_dashboard { server dashboard:3000; }
upstream streamkit_meeting   { server meeting:3000; }
upstream streamkit_grafana   { server grafana:3000; }

# Addresses can hold live credentials. A browser can only put an access token in the address of a WebSocket, and reset and
# verification links carry theirs the same way. So this logs the path and not the query string, and not the Referer either,
# which is the same address again for whatever a page loads next.
log_format streamkit '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "$http_user_agent"';

server {
    listen 80 default_server;
    server_name ${STREAMKIT_DOMAIN};
    access_log /var/log/nginx/access.log streamkit;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${STREAMKIT_DOMAIN};
    access_log /var/log/nginx/access.log streamkit;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 2m;

    proxy_set_header Host $host;
    # Overwritten rather than appended, so the server can trust it for rate limits and audit logs.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Between nodes only. A node ignores this unless it is signed, and nobody outside has a reason to send it.
    proxy_set_header X-StreamKit-Forwarded-By "";
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Signalling sockets stay open for the whole call.
    location /rtc {
        # Its error messages quote the whole request line, as when the server cannot be reached. That still shows as a 502.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://streamkit_server;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
    location /twirp/ { proxy_pass http://streamkit_server; }
    location /api/v1/monitor/live {
        proxy_pass http://streamkit_server;
        proxy_read_timeout 1h;
    }
    location /api/ { proxy_pass http://streamkit_server; }
    # Recordings can be far larger than anything worth buffering here, and a player seeks with Range requests.
    location /api/v1/recordings/ {
        proxy_pass http://streamkit_server;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
    # WHIP publishers post an SDP offer here. Their media goes straight to the server, like everyone else's.
    location /whip/ { proxy_pass http://streamkit_server; }

    # Metrics and health stay inside the Docker network.
    location = /metrics { return 404; }

    location /grafana/ { proxy_pass http://streamkit_grafana; }
    location /meet     { proxy_pass http://streamkit_meeting; }
    location /         { proxy_pass http://streamkit_dashboard; }
}
